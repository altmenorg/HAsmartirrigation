    "lit": "^3.3.3",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.28.0",
    "@rollup/plugin-commonjs": "^29.0.3",
